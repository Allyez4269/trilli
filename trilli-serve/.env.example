# Trilli platform configuration.
# Copy to trilli.env, fill in, then:  set -a; source trilli.env; set +a
# In production, install as /etc/trilli/trilli.env (see deploy/trilli.service).

# --- PostgreSQL ---
TRILLI_DB_HOST=localhost
TRILLI_DB_PORT=5432
TRILLI_DB_NAME=trilli
TRILLI_DB_USER=postgres
TRILLI_DB_PASSWORD=
TRILLI_DB_SSLMODE=disable

# --- Blob storage (Azure) ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=trilli-files

# --- Encryption at rest ---
# Root key wrapping the master key stored in the database. 64 hex characters:
#   openssl rand -hex 32
TRILLI_ROOT_KEY=
# Seeds the master key on FIRST boot only; may be removed afterwards.
APP_ENCRYPTION_KEY=

# --- Email (SendGrid) — optional ---
SENDGRID_API_KEY=
TRILLI_MAIL_FROM=notify@example.com
TRILLI_MAIL_FROM_NAME=Trilli

# --- HTTP / TLS ---
PORT=8081
TRILLI_TLS_CERT=certs/fullchain.pem
TRILLI_TLS_KEY=certs/privkey.pem
# Loopback listener the Collabora engine calls back on (WOPI).
TRILLI_WOPI_LISTEN=127.0.0.1:8090

# --- Storage tiering: off | dryrun | live ---
TRILLI_TIERING_MODE=off

# --- GeoIP — optional ---
# Any random value; gates GET /api/geoip?k=...
TRILLI_GEOIP_KEY=
# db-ip.com account download URL for the ip-to-location-isp mmdb.
TRILLI_DBIP_URL=

# --- OAuth redirect overrides — optional ---
GOOGLE_OAUTH_REDIRECT=
MICROSOFT_OAUTH_REDIRECT=
GOOGLE_DRIVE_OAUTH_REDIRECT=

# --- Office suite ---
# Directory holding blank word.docx / excel.xlsx / impress.pptx templates.
TRILLI_OFFICE_TEMPLATES=templates/office
