# Trilli CMX (operator console) configuration.
# Copy to cmx.env, fill in, then:  set -a; source cmx.env; set +a

# --- PostgreSQL (the SAME database as the Trilli platform) ---
TRILLI_DB_HOST=localhost
TRILLI_DB_PORT=5432
TRILLI_DB_NAME=trilli
TRILLI_DB_USER=postgres
TRILLI_DB_PASSWORD=
TRILLI_DB_SSLMODE=disable

# --- Encryption ---
# Same root key as the platform (unwraps the shared master key).
TRILLI_ROOT_KEY=

# --- TLS ---
TRILLI_TLS_CERT=certs/fullchain.pem
TRILLI_TLS_KEY=certs/privkey.pem

# --- Logging ---
# CMX_DEBUG=1
